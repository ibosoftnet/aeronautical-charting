    "vor_code_id": "GKE",
    "dme_code_id": "GKE",
    "dme_channel": "90X",
    "dme_lat_dd": 35.235278,
    "dme_lon_dd": 33.763611,
    "dme_elev": 60,
    "dme_uom_dist_ver": "M",
    "dme_work_hr": "H24",
    "dme_created_by": "IBOSOFT"
  },

