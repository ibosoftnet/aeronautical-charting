    "suppress": {},
    "type": "vor",
    "vor_code_id": "GKE",
    "vor_name": "GECITKALE",
    "vor_freq": "114.3",
    "vor_declination": "4",
    "vor_lat_dd": 35.235278,
    "vor_lon_dd": 33.763611,
    "vor_work_hr": "H24",
    "vor_created_by": "IBOSOFT",
    "vor_rmk": "Coverage 200 NM. Unusable: BTN R090-R105 beyond 15 NM; BTN R106-R230 beyond 12 NM; BTN R231-R265 beyond 16 NM"
  },

  // GKE DME — CH90X / Elevation 60 M
  {
    "suppress": {},
