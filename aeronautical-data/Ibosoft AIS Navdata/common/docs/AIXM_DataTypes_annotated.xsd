    <simpleType name="CodeApproachPrecisionCategoryBaseType">
        <annotation>
            <documentation>A categorisation of the final approach leg of an Instrument Approach
                Procedure based on the precision of the 3D guidance systems used.</documentation>
        </annotation>
        <union>
            <simpleType>
                <restriction base="xsd:string">
                    <enumeration value="CAT_I">
                        <annotation>
                            <documentation>Precision Approach Category I.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="CAT_II">
                        <annotation>
                            <documentation>Precision Approach Category II.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="CAT_II_AUTOPILOT">
                        <annotation>
                            <documentation>Precision Approach Category II flown with
                                autopilot.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="CAT_III">
                        <annotation>
                            <documentation>Precision Approach Category III.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="GP_INOP">
                        <annotation>
                            <documentation>Localizer Approach (lateral guidance only, no vertical
                                guidance). Also known as “GP-INOP” in the base of a ILS
                                system.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="NON_PRECISION">
                        <annotation>
                            <documentation>Non-precision Approach.</documentation>
                        </annotation>
                    </enumeration>
                </restriction>
            </simpleType>
            <simpleType>
                <restriction base="xsd:string">
                    <pattern value="OTHER(:(\w|_){1,58})?"/>
                </restriction>
            </simpleType>
        </union>
    </simpleType>
    <complexType name="CodeApproachPrecisionCategoryType">
        <annotation>
            <documentation>A complex data type that enables the provision of a NIL reason for any
                attribute using this type.</documentation>
        </annotation>
        <simpleContent>
            <extension base="aixm:CodeApproachPrecisionCategoryBaseType">
                <attribute name="nilReason" type="gml:NilReasonEnumeration">
                    <!--No annotation found for this element.-->
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
