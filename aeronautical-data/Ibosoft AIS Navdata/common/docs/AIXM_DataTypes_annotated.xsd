    <simpleType name="CodeAircraftFieldLengthBaseType">
        <annotation>
            <documentation>A coded value representing the highest value of the aeroplane reference
                field lengths of the aeroplanes for which the runway is intended.</documentation>
        </annotation>
        <union>
            <simpleType>
                <restriction base="xsd:string">
                    <enumeration value="1">
                        <annotation>
                            <documentation>Less than 800 m.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="2">
                        <annotation>
                            <documentation>800 m up to but not including 1 200 m.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="3">
                        <annotation>
                            <documentation>1 200 m up to but not including 1 800 m.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="4">
                        <annotation>
                            <documentation>1 800 m and over</documentation>
                        </annotation>
                    </enumeration>
                </restriction>
            </simpleType>
            <simpleType>
                <restriction base="xsd:string">
                    <pattern value="OTHER(:(\w|_){1,58})?"/>
                </restriction>
            </simpleType>
        </union>
    </simpleType>
    <complexType name="CodeAircraftFieldLengthType">
        <annotation>
            <documentation>A complex data type that enables the provision of a NIL reason for any
                attribute using this type.</documentation>
        </annotation>
        <simpleContent>
            <extension base="aixm:CodeAircraftFieldLengthBaseType">
                <attribute name="nilReason" type="gml:NilReasonEnumeration">
                    <!--No annotation found for this element.-->
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <simpleType name="CodeAirportSignBaseType">
        <annotation>
            <documentation>Signs that situate on or near airport movement to convey a mandatory
                instruction, information on specific location or destination on a movement area or
                to provide information to meet Surface Movement Guidance &amp;amp; Control System
                (SMGCS) requirements.</documentation>
        </annotation>
        <union>
            <simpleType>
                <restriction base="xsd:string">
                    <enumeration value="APRON">
                        <annotation>
                            <documentation>An Inbound destination sign for general parking,
                                servicing, and loading areas. Source: FAA AC
                                150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="CARGO">
                        <annotation>
                            <documentation>An Inbound destination sign for areas set aside for cargo
                                handling. Source: FAA AC 150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="CAT_HOLD">
                        <annotation>
                            <documentation>A category I, II or III holding position sign shall be
                                located on each side of the runway-holding position marking facing
                                the direction of the approach to the critical area. The inscription
                                on a category I, II, III, joint II/III or joint I/II/III holding
                                position sign shall consist of the runway designator followed by CAT
                                I, CAT II, CAT III, CAT II/III or CAT I/II/III, as appropriate.
                                Source: ICAO Annex 14 p 5.4.2.15. Note FAA sign has ILS instead of
                                CAT.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="CIVIL">
                        <annotation>
                            <documentation>An Inbound destination sign for areas set aside for civil
                                aircraft. Source: FAA AC 150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="FBO">
                        <annotation>
                            <documentation>An Inbound destination sign for areas fixed-base
                                operator. Source: FAA AC 150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="FUEL">
                        <annotation>
                            <documentation>An Inbound destination sign for areas where aircraft are
                                fueled or serviced. Source: FAA AC 150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="INFO_NAVAID">
                        <annotation>
                            <documentation>The inscription on the sign shows the facility
                                identification, channel, radial selected (published) for the check,
                                and the plotted distance from the antenna (when applicable). Source:
                                ICAO Annex 14.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="INFO_VEH">
                        <annotation>
                            <documentation>Generic sign for vehicles. Source ED99D.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="INT_TKOF">
                        <annotation>
                            <documentation>An intersection take-off sign should be provided when
                                there is an operational need to indicate the remaining take-off run
                                available (TORA) for intersection take-offs. The inscription on an
                                intersection take-off sign shall consist of a numerical message
                                indicating the remaining take-off run available in meters plus an
                                arrow, appropriately located and oriented, indicating the direction
                                of the take-off. Source ICAO Annex 14.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="INTL">
                        <annotation>
                            <documentation>An Inbound destination sign for areas set aside for
                                handling international flights. Source: FAA AC
                                150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="MIL">
                        <annotation>
                            <documentation>An Inbound destination sign for areas set aside for
                                military aircraft. Source: FAA AC 150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="MIL_HOLD">
                        <annotation>
                            <documentation>The inscription on a holding position sign located at the
                                intersection of a taxiway or designated runway and a military
                                landing zone/assault strip that does not have a runway designation
                                is: “MIL LZ”. Source: FAA AC 150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="NO_ENTRY">
                        <annotation>
                            <documentation>A NO ENTRY sign shall be provided when entry into an area
                                is prohibited. A NO ENTRY sign shall be located at the beginning of
                                the area to which entrance is prohibited on each side of the taxiway
                                as viewed by the pilot. Source: ICAO Annex 14.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="OUTBOUND_DEST">
                        <annotation>
                            <documentation>Outbound destination signs identify directions to takeoff
                                runways. These routes usually begin at the entrance to a taxiway
                                from an apron area. The inscription is the runway number plus an
                                arrow indicating the direction. More than one runway number,
                                separated by a dot, may be shown where the taxiing route is common
                                to both runways. The outbound destination sign should always direct
                                the pilot to the beginning of a takeoff runway. Source: FAA AC
                                150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="PAX">
                        <annotation>
                            <documentation>An Inbound destination sign for areas set aside for
                                passenger handling. Source: FAA AC 150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="RWY_APCH_DEP_HOLD">
                        <annotation>
                            <documentation>The inscription on a sign for a runway approach/departure
                                area is the associated and complete runway designation followed by a
                                dash and the abbreviation “## APCH-## DEP”. The sign is installed on
                                taxiways located in approach/departure areas where an aircraft on a
                                taxiway would either enter or penetrate the airspace required for
                                the approach or departure runway (including clearway). Source AC
                                150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="RWY_CRITICAL">
                        <annotation>
                            <documentation>This sign identifies either the boundary of the ILS
                                critical area, or the POFZ, or the holding position for CAT II/III
                                operations. The sign has a black inscription that depicts the ILS
                                holding position marking on a yellow background. This sign is used
                                at controlled airports on taxiways where the controller commonly
                                asks pilots to report, “clear of the ILS critical area” when exiting
                                these areas. The pilot can use the sign as a guide in deciding when
                                to report back to the controller. Source: FAA AC
                                150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="RWY_DIST_REMAIN">
                        <annotation>
                            <documentation>Runway distance remaining signs are used to provide
                                distance remaining information to pilots during takeoff and landing
                                operations. The sign has a white numeral inscription on a black
                                background. Source: FAA AC 150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="RWY_EXIT">
                        <annotation>
                            <documentation>A runway exit sign shall be provided where there is an
                                operational need to identify a runway exit. The inscription on a
                                runway exit sign shall consist of the designator of the exit taxiway
                                and an arrow indicating the direction to follow. Source: ICAO Annex
                                14.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="RWY_INT_HOLD">
                        <annotation>
                            <documentation>The inscription on a holding position sign at a
                                taxiway/runway intersection is the runway number(s), such as
                                “15-33”. The runway numbers are separated by a dash, and their
                                arrangement indicates the direction to the corresponding runway
                                threshold. Source: FAA AC 150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="RWY_LOCATION">
                        <annotation>
                            <documentation>This sign is located to clearly identify the runways for
                                pilots and only contains the runway designation for the one runway
                                end. Source: ICAO Annex 14.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="RWY_VACATED">
                        <annotation>
                            <documentation>A runway vacated sign shall be provided where the exit
                                taxiway is not provided with taxiway center line lights and there is
                                a need to indicate to a pilot leaving a runway the perimeter of the
                                ILS/MLS critical/sensitive area or the lower edge of the inner
                                transitional surface, whichever is farther from the runway center
                                line. The inscription on a runway vacated sign shall depict the
                                pattern A runway-holding position marking. Source: ICAO Annex
                                14.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="TERM">
                        <annotation>
                            <documentation>An Inbound destination sign for gate positions at which
                                aircraft are loaded or unloaded. Source: FAA AC
                                150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="TWY_DIRECTION">
                        <annotation>
                            <documentation>A direction sign shall be provided when there is an
                                operational need to identify the designation and direction of
                                taxiways at an intersection. The inscription on a direction sign
                                shall comprise an alpha or alphanumeric message identifying the
                                taxiway(s) plus an arrow or arrows appropriately oriented. Source:
                                ICAO Annex 14.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="TWY_END">
                        <annotation>
                            <documentation>This marker sign indicates that a taxiway does not
                                continue beyond an intersection. FAA AC
                                150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="TWY_LOCATION">
                        <annotation>
                            <documentation>Sign identifies the taxiway on which an aircraft is
                                located. Source: ICAO Annex 14.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="VEH_STOP">
                        <annotation>
                            <documentation>Stop signs located on the airfield and are intended
                                solely for vehicle operators. Source AC
                                150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="VEH_YIELD">
                        <annotation>
                            <documentation>Yield signs located on the airfield and are intended
                                solely for vehicle operators. Source AC
                                150/5340-18G.</documentation>
                        </annotation>
                    </enumeration>
                </restriction>
            </simpleType>
            <simpleType>
                <restriction base="xsd:string">
                    <pattern value="OTHER(:(\w|_){1,58})?"/>
                </restriction>
            </simpleType>
        </union>
    </simpleType>
