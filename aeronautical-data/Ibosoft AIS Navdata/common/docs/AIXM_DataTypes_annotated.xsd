    <simpleType name="CodeObstacleAreaBaseType">
        <annotation>
            <documentation>&lt;i&gt;A code indicating the type of obstacle coverage area, according
                to ICAO Annex 15 or FAA&lt;/i&gt;.&#xd; </documentation>
        </annotation>
        <union>
            <simpleType>
                <restriction base="xsd:string">
                    <enumeration value="AREA1">
                        <annotation>
                            <documentation>ICAO Area 1: entire territory of a State.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="AREA2">
                        <annotation>
                            <documentation>ICAO Area 2: Obstacles within Area 2 that are assessed as
                                being a hazard to air nav&lt;font color="#172b4d"&gt;igation (not
                                covered by ICAO Area 2a-d).&lt;/font&gt;</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="AREA3">
                        <annotation>
                            <documentation>&lt;font color="#172b4d"&gt;ICAO Area 3: The area
                                bordering an aerodrome movement area that extends horizontally from
                                the edge of a runway to 90 m from the runway centre line and 50 m
                                from the edge of all other parts of the aerodrome movement
                                area.&lt;/font&gt;</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="AREA4">
                        <annotation>
                            <documentation>&lt;font color="#172b4d"&gt;ICAO Area 4: The area
                                extending 900 m prior to the runway threshold and 60 m each side of
                                the extended runway centre line in the direction of the approach on
                                a precision approach runway, Category II or
                                III.&lt;/font&gt;</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="OLS">
                        <annotation>
                            <documentation>ICAO Annex 14 Obstacle Limitation
                                Surface.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="FAR77">
                        <annotation>
                            <documentation>FAA Regulations Part 77 Obstacle Limitation
                                Surfaces.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="AREA2A">
                        <annotation>
                            <documentation>ICAO Area 2a: A rectangular area around a runway that
                                comprises the runway strip plus any clearway that
                                exists.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="AREA2B">
                        <annotation>
                            <documentation>ICAO Area 2b: An area extending from the ends of Area 2a
                                in the direction of departure, with a length of 10 km and a splay of
                                15 per cent to each side.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="AREA2C">
                        <annotation>
                            <documentation>ICAO Area 2c: An area extending outside Area 2a and Area
                                2b at a distance of not more than 10 km from the boundary of Area
                                2a.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="AREA2D">
                        <annotation>
                            <documentation>ICAO Area 2d: An area outside Areas 2a, 2b and 2c up to a
                                distance of 45 km from the aerodrome reference point, or to an
                                existing terminal control area (TMA) boundary, whichever is
                                nearest.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="AREA2_HAZARD">
                        <annotation>
                            <documentation>An area similar to Area 2, but which is used for
                                identifying obstacles that have been assessed as being a hazard to
                                air navigation and which do not match the criteria for being
                                collected as obstacles in Area 2 A/B/C/D.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="TAKE_OFF_FLIGHT_PATH_AREA">
                        <annotation>
                            <documentation>A quadrilateral area starting from the end of a runway or
                                of the clearway, on the surface of the earth lying directly below,
                                and symmetrically disposed about, the take-off flight
                                path.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="OLS_OUTER_HORIZONTAL_SURFACE">
                        <annotation>
                            <documentation>Outer horizontal surface.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="OLS_CONICAL_SURFACE">
                        <annotation>
                            <documentation>A surface sloping upwards and outwards from the periphery
                                of the inner horizontal surface.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="OLS_INNER_HORIZONTAL_SURFACE">
                        <annotation>
                            <documentation>A surface located in a horizontal plane above an
                                aerodrome and its environs.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="OLS_APPROACH_SURFACE">
                        <annotation>
                            <documentation>An inclined plane or combination of planes preceding the
                                threshold.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="OLS_INNER_APPROACH_SURFACE">
                        <annotation>
                            <documentation>A rectangular portion of the approach surface immediately
                                preceding the threshold.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="OLS_TRANSITIONAL_SURFACE">
                        <annotation>
                            <documentation>A complex surface along the side of the strip and part of
                                the side of the approach surface, that slopes upwards and outwards
                                to the inner horizontal surface.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="OLS_INNER_TRANSITIONAL_SURFACE">
                        <annotation>
                            <documentation>A surface similar to the transitional surface but closer
                                to the runway.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="OLS_BALKED_LANDING_SURFACE">
                        <annotation>
                            <documentation>An inclined plane located at a specified distance after
                                the threshold, extending between the inner transitional
                                surface.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="OLS_TAKE_OFF_CLIMB_SURFACE">
                        <annotation>
                            <documentation>An inclined plane or other specified surface beyond the
                                end of a runway or clearway.</documentation>
                        </annotation>
                    </enumeration>
                </restriction>
            </simpleType>
            <simpleType>
                <restriction base="xsd:string">
                    <pattern value="OTHER(:(\w|_){1,58})?"/>
                </restriction>
            </simpleType>
        </union>
    </simpleType>
