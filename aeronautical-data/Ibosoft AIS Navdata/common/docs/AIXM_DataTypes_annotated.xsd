                    </enumeration>
                    <enumeration value="NOT_VERIFIED">
                        <annotation>
                            <documentation>The data is provided without having passed the processes
                                for validation and verification and could be
                                inaccurate.</documentation>
                        </annotation>
                    </enumeration>
                </restriction>
            </simpleType>
            <simpleType>
                <restriction base="xsd:string">
                    <pattern value="OTHER(:(\w|_){1,58})?"/>
                </restriction>
            </simpleType>
        </union>
