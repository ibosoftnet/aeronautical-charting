    <simpleType name="CodeSegmentPathBaseType">
        <annotation>
            <documentation>A code that defines a specific type of flight path and a specific type of
                termination of that flight path. Although we agree with the ARINC idea that
                procedures should be designed with the aim to permit FMS equipped aircraft to fly
                tracks instead of procedural headings, for the time being we must allow all
                representation of these procedures (especially reversal procedures) as they are
                published by the States. This is the explanation of the differences between the
                allowable values for attributes in this domain and the ARINC leg types. &#xd;
            </documentation>
        </annotation>
        <union>
            <simpleType>
                <restriction base="xsd:string">
                    <enumeration value="AF">
                        <annotation>
                            <documentation>(ARINC) constant DME arc to a fix.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="HF">
                        <annotation>
                            <documentation>(ARINC) hold pattern terminating at a fix after one
                                circuit.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="HA">
                        <annotation>
                            <documentation>(ARINC) hold pattern term. at fix after reach. an
                                altitude.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="HM">
                        <annotation>
                            <documentation>(ARINC) holding pattern terminating
                                manually.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="IF">
                        <annotation>
                            <documentation>(ARINC) initial fix.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="PI">
                        <annotation>
                            <documentation>(ARINC) procedure turn followed by a course to a fix
                                (CF).</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="PT">
                        <annotation>
                            <documentation>(non ARINC) timed outbound leg to a procedure
                                turn.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="TF">
                        <annotation>
                            <documentation>(ARINC) track between two fixes.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="CA">
                        <annotation>
                            <documentation>(ARINC) course to an altitude.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="CD">
                        <annotation>
                            <documentation>(ARINC) course to a DME distance.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="CI">
                        <annotation>
                            <documentation>(ARINC) course to next leg followed by course oriented
                                leg.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="CR">
                        <annotation>
                            <documentation>(ARINC) course to a radial termination.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="CF">
                        <annotation>
                            <documentation>(ARINC) course to a fix.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="DF">
                        <annotation>
                            <documentation>(ARINC) Computed track direct to a fix.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="FA">
                        <annotation>
                            <documentation>(ARINC) course from a fix to an altitude.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="FC">
                        <annotation>
                            <documentation>(ARINC) course from a fix to a distance.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="FT">
                        <annotation>
                            <documentation>(non ARINC) course from a fix during a specified
                                time.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="FM">
                        <annotation>
                            <documentation>(ARINC) course from a fix to a manual
                                termination.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="VM">
                        <annotation>
                            <documentation>(ARINC) heading to a manual termination.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="FD">
                        <annotation>
                            <documentation>(ARINC) course from a fix to a DME
                                distance.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="VR">
                        <annotation>
                            <documentation>(ARINC) heading to a radial termination.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="VD">
                        <annotation>
                            <documentation>(ARINC) heading to a DME distance.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="VI">
                        <annotation>
                            <documentation>(ARINC) heading to next leg.</documentation>
