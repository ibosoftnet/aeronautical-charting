    <simpleType name="CodeSegmentTerminationBaseType">
        <annotation>
            <documentation>A code indicating the end point of a terminal procedure segment leg.&#xd;
            </documentation>
        </annotation>
        <union>
            <simpleType>
                <restriction base="xsd:string">
                    <enumeration value="ALTITUDE">
                        <annotation>
                            <documentation>Leg is terminated when reaching the altitude conditions
                                specified in the segment leg.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="DISTANCE">
                        <annotation>
                            <documentation>Leg is terminated when the distance has
                                passed.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="DURATION">
                        <annotation>
                            <documentation>Leg is terminated when the duration has
                                passed.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="INTERCEPT">
                        <annotation>
                            <documentation>Leg is terminated when reaching the limiting angle
                                indication.</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="ALTITUDE_AND_DISTANCE">
                        <annotation>
                            <documentation>Used to indicate that the leg has a conditional altitude
                                termination, meaning the SegmentLeg ends as specified by the
                                distance or at or above the altitude specified, under the condition
                                indicated. Condition is whichever is later (altitude and reaching
                                DME distance/flight distance).</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="ALTITUDE_OR_DISTANCE">
                        <annotation>
                            <documentation>Used to indicate that the leg has a conditional altitude
                                termination, meaning the SegmentLeg ends as specified by the
                                distance or at or above the altitude specified, under the condition
                                indicated. Condition is whichever is earlier (altitude or reaching
                                DME distance/flight distance).</documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="DME_DISTANCE">
                        <annotation>
                            <documentation>Leg is terminated when reaching the limiting distance
                                indication defined by a DME associated with the leg.</documentation>
                        </annotation>
                    </enumeration>
                </restriction>
            </simpleType>
            <simpleType>
                <restriction base="xsd:string">
                    <pattern value="OTHER(:(\w|_){1,58})?"/>
                </restriction>
            </simpleType>
        </union>
    </simpleType>
    <complexType name="CodeSegmentTerminationType">
