      // Tailored pist (runway) overrides / ek kayıtlar
  // ------------------------------------------------------------
  // Bu dosya `ad_hp_runways` nihai çıktı alan adlarını kullanır.
  // Grain, gerçek RWY-DIR verisiyle aynıdır: 1 kayıt = 1 pist YÖNÜ
  // (`ahp_code_id` + `direction_designator`). Pist çiftleri her zaman
  // 2 yönlü olmak zorunda değildir (tek taraf kullanımlı/yayınlı pistler
  // de vardır) — bu yüzden otomatik "çifte bölme" YAPILMAZ. İki yönü olan
  // bir pist için iki ayrı giriş yazmanız gerekir (ortak alanları — uzunluk,
  // yüzey, PCN vb. — her ikisine de tekrarlayın).
  //
  // Buraya eklenen kayıtlar `ahp_code_id` + `direction_designator` ile eşleşir.
  // Aynı (ahp_code_id, direction_designator) mevcutsa bu kayıt TAM override
  // sayılır: kaynak XML'den alan mirası yapılmaz, vermediğiniz alanlar boş kalır.
  //
  // Gerekli minimum alanlar: `ahp_code_id` + `direction_designator`
  //
  // Sık kullanılan temel alanlar:
  // `rwy_designator` (pist çifti etiketi, örn. "RWY 17/35"),
  // `true_bearing`, `mag_bearing`,
  // `info_length`, `info_width`, `info_dim_unit`,
  // `info_surface_composition`, `info_surface_condition`, `info_surface_preparation`,
  // `info_pcn_class`, `info_pcn_pavement_type`, `info_pcn_pavement_subgrade`,
  // `info_pcn_max_tire_pressure_code`, `info_pcn_eval_method`, `info_pcn_note`,
  // `info_lcn_class`, `info_strip_length`, `info_strip_width`, `info_strip_dim_unit`,
  // `info_auw_weight`, `info_auw_weight_unit`,
  // `info_siwl_weight`, `info_siwl_weight_unit`,
  // `info_siwl_tire_pressure`, `info_siwl_tire_pressure_unit`,
  // `info_marking_rmk`, `info_profile_rmk`, `info_rmk`, `info_status`,
  // `dir_dt_wef`, `dir_created_by`, `info_dt_wef`, `info_dt_com`, `info_created_by`
  //
  // İsteğe bağlı: `enabled: false` ile bir kaydı geçici olarak devre dışı bırakabilirsiniz.
  // match_id buraya yazılmaz — script otomatik atar (aynı ahp_code_id'ye sahip
  // airport kaydıyla aynı değeri paylaşır).
  //"runways": [
    // ÖRNEK — LT1401/BOLU için tailored pist (tek yön, sys_rmk'ye göre "Concrete")
    // {
    //   "enabled": true,
    //   "ahp_code_id": "LT1401",
    //   "direction_designator": "09",
    //   "rwy_designator": "RWY 09",
    //   "info_surface_composition": "CONC",
    //   "info_created_by": "IBOSOFT"
    // }
  //]
    {
      "enabled": true,
      "join_key": "LCIK",
      "name": "GİRNE/KARTER HELIPORT",
      "city": "GİRNE",
      "country": "NORTHERN CYPRUS",
      "code_icao": "LCIK",
      "code_iata": "",
      "code_type": "HP",
      "lat_dd": 35.275833,
      "lon_dd": 33.267222,
      "lat_text": "351633N",
      "lon_text": "0331602E",
      "usage_time_ref": "UTC",
      "usage_type": "GAT | OAT",
      "usage_rule": "IFR | VFR",
      "usage_mil": "CIVIL | MIL",
      "usage_origin": "IBOSOFT",
      "usage_purpose": "NS | P",
      "usage_status": "ACTIVE",
      "usage_org_name": "Güvenlik Kuvvetleri Havacılık Birlik Komutanlığı, Dikmen/GİRNE",
      "sys_rmk": "Elev 772 FT (235.30 M). Geoid undulation 91 FT. Mag var 5.26E (2020), annual change 4.5. AFS: LCIKZTZX. Traffic: NTL, IFR-VFR, Military-Non-scheduled-Private. Authorization from TRNC Security Forces Command required before filing flight plans. IFR traffic approaches LCEN (Ercan), lands at Karter after obtaining VFR. Fuel: JP-8 (limited), 1 truck 20600 L, 1000 L/min. De-icing: NIL. Hangar: 2 semi-closed. Fire: H2; CFR team summer 0500-1400, winter 0600-1500 UTC. Seasonal clearing: NIL. Landing area 50x50 M asphalt; parking 60x100 M concrete; taxiway 22 M concrete, T1-T4. Security: H24. AIS/ARO/MET via LCEN. Customs: not available."
    },

