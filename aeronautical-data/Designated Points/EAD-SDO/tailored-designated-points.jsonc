/**
 * Tailored Designated Point Veri Dosyası
 *
 * Bu dosya manuel giriş, değişiklik ve suppress işlemleri için kullanılır.
 *
 * Kök yapı:
 *   - "_effectivity_keys": data_effectivity için kısayol anahtarları (örn. "eff_trnc" →
 *     "15 MAY 2025 (AIRAC 2505)"). Bir kayıtta data_effectivity bu anahtarlardan biri
 *     ise gerçek değere otomatik çözümlenir; anahtar değilse olduğu gibi kullanılır.
 *   - "points": Tailored kayıtların listesi.
 *
 * Suppress Mantığı:
 *   - code_id ve data_originator IKISI DA girilirse: EAD-SDO'daki matching kaydı siler,
 *     yerine tailored giriş eklenir
 *   - code_id veya data_originator boşsa: Ek kayıt olarak layer'a eklenir, XML verisi dokunulmaz
 *
 * Fields:
 *   - code_id: Designation Point Code (örn. "ABMEL", "ALVOR")
 *   - code_type: Type (örn. "ADHP", "RNAV")
 *   - name: Descriptive name
 *   - datum: Coordinate datum (örn. "WGE" = WGS84)
 *   - lat_dd: Latitude (decimal degrees)
 *   - lon_dd: Longitude (decimal degrees)
 *   - dt_wef: Date with effect (örn. "01/04/2026")
 *
 * Provenance (data_provider her zaman "Ibosoft AIS" olarak zorlanır, elle girilmez):
 *   - data_originator: Kaydın gerçek kaynağı (örn. "KKTC SHD", "DHMİ Türkiye")
 *   - data_effectivity: AIRAC/geçerlilik tarihi veya yukarıdaki _effectivity_keys'den bir anahtar
 */

{
  "_effectivity_keys": {
    "eff_trnc": "15 MAY 2025 (AIRAC 2505)",
    "eff_lt": "09 JUL 2026 (AIRAC 2607)"
  },
  "points": [
    // Örnek 1: DP suppress (EAD-SDO'daki matching kaydını sil, yenisini ekle)
    /*
    {
      "suppress": {
        "code_id": "ABMEL",
        "data_originator": "EUROCONTROL"
      },
      "code_id": "ABMEL",
      "code_type": "ADHP",
      "name": "ABMEL (Updated)",
      "datum": "WGE",
      "lat_dd": 40.1234,
      "lon_dd": 28.5678,
      "dt_wef": "01/04/2026",
      "data_originator": "KKTC SHD",
      "data_effectivity": "eff_trnc"
    },
    */

    // Örnek 2: DP ek kayıt (suppress boş → sadece ekle)
    /*
    {
      "suppress": {},
      "code_id": "NEWDP",
      "code_type": "RNAV",
      "name": "NEW DESIGNATED POINT",
      "datum": "WGE",
      "lat_dd": 40.5000,
      "lon_dd": 29.5000,
      "dt_wef": "01/04/2026",
      "data_originator": "DHMİ Türkiye",
      "data_effectivity": "eff_lt"
    }
    */
  ]
}
